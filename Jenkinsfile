pipeline {
    agent any

    parameters {
        choice(name: 'BUILD_TARGET', choices: ['StandaloneWindows64', 'StandaloneWindows64', 'Android', 'iOS'], description: '빌드 타깃 플랫폼')
        choice(name: 'BUILD_TYPE', choices: ['DEV', 'DEV', 'QA', 'LIVE'], description: '빌드 환경 모드')
        string(name: 'BUILD_VERSION', defaultValue: '1.0.0', description: '앱 버전 (Bundle Version)')
        string(name: 'VERSION_CODE', defaultValue: '1', description: '버전 코드 (Android/iOS)')
        booleanParam(name: 'DEV_BUILD', defaultValue: false, description: 'Development Build 활성화')
        booleanParam(name: 'CLEAN_BUILD', defaultValue: false, description: 'Clean Build Cache')
        booleanParam(name: 'IS_AAB', defaultValue: false, description: 'Android App Bundle(.aab) 빌드 여부')
        booleanParam(name: 'ZIP_PACKAGE', defaultValue: false, description: 'PC 빌드 결과물 ZIP 압축 여부')
    }

    environment {
        // Unity 실행 파일 경로를 환경에 맞게 지정하세요
        UNITY_PATH = 'C:/Program Files/Unity/Hub/Editor/6000.0.46f1/Editor/Unity.exe'
        PROJECT_PATH = "${WORKSPACE}"
        OUTPUT_DIR = "${WORKSPACE}/BuildOutput"
        LOG_FILE = "${WORKSPACE}/build.log"
    }

    stages {
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Unity Player Build') {
            steps {
                script {
                    echo "Starting Unity CLI Build: Target=${params.BUILD_TARGET}, Type=${params.BUILD_TYPE}, Ver=${params.BUILD_VERSION}"
                    
                    def unityArgs = """
                        \"${UNITY_PATH}\" -batchmode -quit \
                        -projectPath \"${PROJECT_PATH}\" \
                        -executeMethod ProjectBuild.JenkinsBuild \
                        -logFile \"${LOG_FILE}\" \
                        -buildTarget ${params.BUILD_TARGET} \
                        -buildType ${params.BUILD_TYPE} \
                        -buildVersion ${params.BUILD_VERSION} \
                        -versionCode ${params.VERSION_CODE} \
                        -devBuild ${params.DEV_BUILD} \
                        -cleanBuild ${params.CLEAN_BUILD} \
                        -isAab ${params.IS_AAB} \
                        -zipPackage ${params.ZIP_PACKAGE} \
                        -sceneList \"Assets/Scenes/SampleScene.unity\" \
                        -outputPath \"${OUTPUT_DIR}\"
                    """.stripIndent().trim()

                    if (isUnix()) {
                        sh unityArgs
                    } else {
                        bat unityArgs
                    }
                }
            }
        }

        stage('Archive Artifacts') {
            steps {
                archiveArtifacts artifacts: 'BuildOutput/**', allowEmptyArchive: true
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'build.log', allowEmptyArchive: true
        }
        success {
            echo 'Unity Build Completed Successfully!'
        }
        failure {
            echo 'Unity Build Failed. Check build.log for details.'
        }
    }
