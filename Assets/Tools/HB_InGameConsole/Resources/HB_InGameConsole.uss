/* HB_InGameConsole.uss - In-Game Console UI Stylesheet */

.hb-root-container {
    flex-grow: 1;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 좌상단 실시간 성능 & 프레임 타임 위젯 */
.hb-fps-widget {
    position: absolute;
    top: 14px;
    left: 14px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(20, 22, 26, 0.88);
    border-width: 1px;
    border-color: rgba(70, 75, 88, 0.6);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 5px;
    padding-bottom: 5px;
}

.hb-fps-widget:hover {
    border-color: rgba(100, 115, 140, 0.9);
    background-color: rgba(25, 28, 34, 0.95);
}

.hb-fps-info {
    flex-direction: column;
    justify-content: center;
    margin-right: 8px;
    min-width: 58px;
}

.hb-fps-text {
    font-size: 13px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.hb-ms-text {
    font-size: 10px;
    color: rgb(150, 155, 170);
    margin: 0;
    padding: 0;
}

/* 프레임 상태별 텍스트 색상 */
.hb-fps-good {
    color: rgb(74, 222, 128);
}

.hb-fps-warn {
    color: rgb(251, 191, 36);
}

.hb-fps-bad {
    color: rgb(248, 113, 113);
}

/* 프레임 타임 그래프 캔버스 */
.hb-fps-graph-canvas {
    width: 110px;
    height: 32px;
    background-color: rgba(10, 11, 14, 0.7);
    border-width: 1px;
    border-color: rgba(50, 54, 66, 0.7);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.hb-graph-collapsed {
    display: none;
}

/* 우상단 열기 버튼 */
.hb-open-button {
    position: absolute;
    top: 14px;
    right: 14px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 7px;
    padding-bottom: 7px;
    background-color: rgba(30, 32, 38, 0.88);
    color: rgb(240, 240, 240);
    border-width: 1px;
    border-color: rgb(80, 85, 98);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    font-size: 13px;
    -unity-font-style: bold;
}

.hb-open-button:hover {
    background-color: rgba(50, 54, 65, 0.95);
    border-color: rgb(110, 118, 135);
}

.hb-open-button:active {
    background-color: rgba(70, 75, 90, 1);
}

/* 콘솔 메인 윈도우 */
.hb-console-window {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(22, 23, 28, 0.94);
    display: flex;
    flex-direction: column;
}

.hb-hidden {
    display: none;
}

/* 헤더 툴바 */
.hb-header-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: rgba(16, 17, 21, 0.98);
    border-bottom-width: 1px;
    border-bottom-color: rgb(45, 47, 56);
}

.hb-header-left {
    flex-direction: row;
    align-items: center;
}

.hb-header-title {
    color: rgb(235, 235, 240);
    font-size: 14px;
    -unity-font-style: bold;
    margin-right: 10px;
}

.hb-header-stats {
    color: rgb(74, 222, 128);
    font-size: 11px;
    -unity-font-style: bold;
}

.hb-toolbar-group {
    flex-direction: row;
    align-items: center;
}

.hb-toolbar-separator {
    width: 1px;
    height: 16px;
    background-color: rgb(55, 60, 70);
    margin-left: 6px;
    margin-right: 6px;
}

/* 필터 및 액션 버튼 */
.hb-filter-btn {
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 4px;
    padding-bottom: 4px;
    margin-left: 2px;
    margin-right: 2px;
    background-color: rgb(38, 40, 48);
    color: rgb(180, 185, 195);
    border-width: 1px;
    border-color: rgb(58, 62, 72);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    font-size: 12px;
}

.hb-filter-btn:hover {
    background-color: rgb(52, 56, 66);
    color: rgb(240, 240, 245);
}

.hb-filter-active {
    background-color: rgb(46, 117, 219);
    border-color: rgb(75, 145, 247);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.hb-action-btn {
    padding-left: 11px;
    padding-right: 11px;
    padding-top: 4px;
    padding-bottom: 4px;
    margin-left: 4px;
    margin-right: 2px;
    background-color: rgb(48, 50, 60);
    color: rgb(220, 225, 235);
    border-width: 1px;
    border-color: rgb(68, 72, 84);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    font-size: 12px;
}

.hb-action-btn:hover {
    background-color: rgb(62, 66, 78);
}

.hb-close-btn {
    width: 26px;
    height: 26px;
    margin-left: 8px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgb(185, 42, 42);
    color: rgb(255, 255, 255);
    border-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    font-size: 13px;
    -unity-font-style: bold;
}

.hb-close-btn:hover {
    background-color: rgb(215, 52, 52);
}

/* 서브 툴바 (검색 및 태그) */
.hb-sub-toolbar {
    flex-direction: row;
    align-items: center;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 5px;
    padding-bottom: 5px;
    background-color: rgba(20, 21, 26, 0.95);
    border-bottom-width: 1px;
    border-bottom-color: rgb(38, 41, 50);
}

.hb-search-container {
    flex-direction: row;
    align-items: center;
    width: 280px;
    margin-right: 12px;
}

.hb-search-field {
    flex-grow: 1;
    font-size: 11px;
    color: rgb(230, 230, 240);
    margin: 0;
}

.hb-search-field > .unity-text-field__input {
    background-color: rgb(28, 30, 36);
    border-color: rgb(55, 59, 70);
    border-radius: 4px;
    padding-left: 6px;
    padding-right: 6px;
}

.hb-search-clear-btn {
    width: 20px;
    height: 20px;
    margin-left: 2px;
    padding: 0;
    background-color: rgb(40, 44, 52);
    color: rgb(180, 185, 195);
    border-width: 0;
    border-radius: 3px;
    font-size: 10px;
}

.hb-tag-scroll {
    flex-grow: 1;
    height: 26px;
}

.hb-tag-scroll .unity-scroll-view__content-container {
    flex-direction: row;
    align-items: center;
}

.hb-tag-btn {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-right: 4px;
    background-color: rgb(32, 35, 42);
    color: rgb(160, 168, 185);
    border-width: 1px;
    border-color: rgb(50, 55, 68);
    border-radius: 3px;
    font-size: 11px;
}

.hb-tag-btn:hover {
    background-color: rgb(44, 48, 60);
    color: rgb(230, 235, 245);
}

.hb-tag-btn-active {
    background-color: rgb(35, 95, 175);
    border-color: rgb(60, 125, 220);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

/* 로그 목록 ScrollView */
.hb-log-scroll {
    flex-grow: 1;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
}

/* Watch 목록 ScrollView */
.hb-watch-scroll {
    flex-grow: 1;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.hb-watch-row {
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
    margin-bottom: 3px;
    background-color: rgba(28, 30, 36, 0.85);
    border-width: 1px;
    border-color: rgba(50, 54, 66, 0.6);
    border-radius: 4px;
}

.hb-watch-row:hover {
    background-color: rgba(38, 42, 52, 0.95);
    border-color: rgba(75, 82, 100, 0.9);
}

.hb-watch-key {
    min-width: 160px;
    color: rgb(140, 190, 255);
    font-size: 12px;
    -unity-font-style: bold;
}

.hb-watch-val {
    flex-grow: 1;
    color: rgb(74, 222, 128);
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
}

.hb-watch-time {
    color: rgb(120, 125, 138);
    font-size: 10px;
    margin-left: 10px;
}

/* 로그 아이템 */
.hb-log-row {
    flex-direction: row;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 5px;
    padding-bottom: 5px;
    margin-bottom: 2px;
    background-color: rgba(30, 32, 38, 0.7);
    border-bottom-width: 1px;
    border-bottom-color: rgba(48, 52, 62, 0.4);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.hb-log-row:hover {
    background-color: rgba(42, 46, 56, 0.9);
}

.hb-log-row-selected {
    background-color: rgba(52, 72, 108, 0.9);
    border-bottom-color: rgb(75, 105, 155);
}

.hb-log-time {
    color: rgb(110, 145, 210);
    font-size: 12px;
    margin-right: 8px;
    min-width: 60px;
}

.hb-log-type-tag {
    font-size: 11px;
    -unity-font-style: bold;
    margin-right: 8px;
    min-width: 45px;
}

.hb-log-channel-tag {
    font-size: 10px;
    padding-left: 4px;
    padding-right: 4px;
    margin-right: 6px;
    background-color: rgba(45, 60, 90, 0.75);
    color: rgb(150, 190, 255);
    border-radius: 2px;
    -unity-font-style: bold;
}

.hb-log-message {
    flex-grow: 1;
    font-size: 12px;
    white-space: normal;
}

/* 로그 타입별 색상 */
.hb-type-info {
    color: rgb(100, 180, 255);
}

.hb-text-info {
    color: rgb(225, 230, 240);
}

.hb-type-warn {
    color: rgb(255, 195, 45);
}

.hb-text-warn {
    color: rgb(255, 215, 100);
}

.hb-type-error {
    color: rgb(255, 80, 80);
}

.hb-text-error {
    color: rgb(255, 120, 120);
}

/* 하단 상세 영역 */
.hb-detail-panel {
    height: 140px;
    background-color: rgba(15, 16, 20, 0.96);
    border-top-width: 1px;
    border-top-color: rgb(42, 45, 54);
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 6px;
    padding-bottom: 6px;
}

.hb-detail-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.hb-detail-title {
    color: rgb(160, 165, 175);
    font-size: 11px;
    -unity-font-style: bold;
}

.hb-copy-btn {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: rgb(40, 44, 52);
    color: rgb(180, 185, 195);
    border-width: 1px;
    border-color: rgb(60, 65, 75);
    border-radius: 3px;
    font-size: 10px;
}

.hb-copy-btn:hover {
    background-color: rgb(55, 60, 72);
}

.hb-detail-scroll {
    flex-grow: 1;
}

.hb-detail-body {
    color: rgb(210, 215, 225);
    font-size: 11px;
    white-space: normal;
}
